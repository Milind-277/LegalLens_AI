# LegalLens AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Python 3.14 compatibility — Protobuf C extension is incompatible with Python 3.14.
# Keep this set to 'python' unless you are running Python 3.11 or 3.12.
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Google Generative AI API Key (required for AI features)
GOOGLE_API_KEY=your_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-random-secret-key

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10
UPLOAD_FOLDER=uploads

# AI Configuration
AI_MODEL_NAME=gemini-3.6-flash
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60
AI_MAX_CONTEXT_CHUNKS=10

# Logging
LOG_LEVEL=INFO
